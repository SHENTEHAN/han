{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "Database": {
    "Path": "data/invoiceeye.db"
  },
  "Vision": {
    "Engine": "Auto",
    "OpenEVision": {
      "OcrModel": "vision/invoice.o2m",
      "Templates": {
        "TotalLabel": "vision/total_label.png",
        "EInvoiceTitle": "vision/einvoice_title.png"
      },
      "Topology": {
        "InvoiceNumber": "[LN]{10}",
        "Period": "[LN]{3,12}",
        "Amount": "N{1,7}"
      }
    }
  }
}
